# Copy this file to .env (which is git-ignored) and fill in the real values,
# then run:  ./scripts/apply-secrets.sh
#
# These values are turned into Kubernetes Secrets in the cluster; they are never
# committed to git. .env stays only on your Mac.

# Cloudflare API token used by cert-manager for the DNS-01 challenge.
# Scope: Zone -> DNS -> Edit, limited to the lkwplus.com zone.
CLOUDFLARE_API_TOKEN=

# --- multica (apps/multica) — consumed by scripts/apply-secrets.sh -> multica-secrets ---
# Stable secrets: generate ONCE and keep them. Rotating JWT_SECRET logs everyone out;
# rotating the Postgres password breaks auth against the existing database.
#   MULTICA_JWT_SECRET=$(openssl rand -hex 32)
#   MULTICA_POSTGRES_PASSWORD=$(openssl rand -hex 16)
MULTICA_JWT_SECRET=
MULTICA_POSTGRES_PASSWORD=
# Resend API key for login verification-code emails (https://resend.com). The From
# address is non-secret config and lives in apps/multica/values.yaml.
MULTICA_RESEND_API_KEY=

# GitHub App integration (https://multica.ai/docs/zh/github-integration). SLUG +
# WEBHOOK_SECRET are required to enable it; APP_ID + the private key are optional but
# give a nicer "connected to <org>" UX. The multiline PEM is stored base64 on one line:
#   MULTICA_GITHUB_APP_PRIVATE_KEY_B64=$(openssl base64 -A < your-app.private-key.pem)
MULTICA_GITHUB_APP_SLUG=
MULTICA_GITHUB_APP_ID=
MULTICA_GITHUB_WEBHOOK_SECRET=
MULTICA_GITHUB_APP_PRIVATE_KEY_B64=

# --- supabase (apps/supabase) — consumed by scripts/apply-secrets.sh -> 8 supabase-* Secrets ---
# Don't hand-fill these: run `./scripts/supabase-gen-secrets.sh` ONCE and paste its output here
# (it signs the anon/service JWTs from the JWT secret and rolls the rest of the random tokens).
# Stable: rotating SUPABASE_JWT_SECRET invalidates the keys; rotating SUPABASE_DB_PASSWORD
# breaks the existing database. The only value you fill by hand is the Resend API key below.
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_DASHBOARD_USERNAME=supabase
SUPABASE_DASHBOARD_PASSWORD=
SUPABASE_ANALYTICS_PUBLIC_TOKEN=
SUPABASE_ANALYTICS_PRIVATE_TOKEN=
SUPABASE_REALTIME_SECRET_KEY_BASE=
SUPABASE_META_CRYPTO_KEY=
SUPABASE_S3_KEY_ID=
SUPABASE_S3_ACCESS_KEY=
# Resend SMTP for GoTrue auth emails. Username is literally "resend"; the password is your
# Resend API key (re_...) — the same key multica uses. Host/port/sender live in values.yaml.
SUPABASE_SMTP_USERNAME=resend
SUPABASE_SMTP_PASSWORD=
# Optional: OpenAI key for Studio's in-dashboard SQL assistant (leave blank to disable).
SUPABASE_OPENAI_API_KEY=

# --- node IPs (node-config/) — consumed by `make node-config`, NOT apply-secrets.sh ---
# Public IPs of the cluster nodes. Private like everything else in .env: they fill
# the __NODE_IP__ placeholder in node-config/<node>.config.yaml at apply time, so
# no real IP is ever committed to git.
NODE_IP_ARM=
NODE_IP_AMD1=
NODE_IP_AMD2=
NODE_IP_SG=

# --- backups (apps/*/backup.yaml) — consumed by scripts/apply-secrets.sh -> backup-r2 ---
# S3 credentials for the nightly backup CronJobs that push to Cloudflare R2; turned into
# a `backup-r2` Secret in each app namespace (wallos, multica, supabase). Create an R2
# API token scoped to one bucket (R2 -> Manage API tokens -> Object Read & Write).
# The endpoint is account-wide:  https://<account-id>.r2.cloudflarestorage.com
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=
BACKUP_R2_ENDPOINT_URL=
