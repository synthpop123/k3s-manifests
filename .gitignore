# Plaintext secrets — never commit these. (secrets.enc.env IS committed on
# purpose: it's sops+age-encrypted, every value an ENC[...] blob; `make lint`
# verifies that.)
.env
.env.*
!.env.example
*.secret.yaml
*-secret.yaml
*.key
*.pem
*.token

# Kubeconfigs
kubeconfig*
*.kubeconfig

# OS / editor junk
.DS_Store
*.swp
